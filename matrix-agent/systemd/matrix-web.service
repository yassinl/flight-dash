[Unit]
Description=Flight Dashboard — Web + mDNS server
After=matrix-wifi-ap.service network.target
Wants=matrix-wifi-ap.service

[Service]
Type=simple
User=freakypigeon
WorkingDirectory=/home/freakypigeon/workspace/flight-dash/matrix-agent
ExecStart=/usr/bin/python3 /home/freakypigeon/workspace/flight-dash/matrix-agent/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
